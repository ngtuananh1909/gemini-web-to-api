# Gateway listener and local dashboard
HOST=127.0.0.1
PORT=4981
API_AUTH_ENABLED=true
# Optional. Set a long random value for a stable client key. When empty, the
# gateway generates and persists a local key under GATEWAY_DATA_DIR.
API_KEY=
GATEWAY_DATA_DIR=.gateway
# Defaults to true on loopback and false on public listeners. Compose enables
# it explicitly because the container port is published only on host loopback.
# DASHBOARD_ENABLED=true

# Logging and runtime environment
LOG_LEVEL=info
APP_ENV=development

# Gemini Web session
# Open Developer Tools (F12) -> Network, select a Gemini batchexecute request,
# and copy its complete Cookie request header. Keep this file private.
GEMINI_COOKIES=
# If the request URL contains /u/2/, set 2 here. Leave empty when the URL has
# no /u/<number>/ segment. The cookie and slot must come from the same tab.
GEMINI_AUTH_USER=
GEMINI_REFRESH_INTERVAL=5
GEMINI_MAX_RETRIES=3
GEMINI_TEMPORARY=false

# Optional request limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
